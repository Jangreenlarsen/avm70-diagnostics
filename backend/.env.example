# AVM70-adresse (LAN-adresse, ikke en hemmelighed). Kan også ændres i UI'et,
# hvorefter den gemmes i data/settings.json og har forrang over denne fil.
AVM_HOST=10.1.1.7
AVM_PORT=14999
# AVM70's web-API (netværksdetaljer). Normalt 80.
AVM_WEB_PORT=80
# Sekunder mellem polling af runtime-værdier (0 = slået fra, kun push).
POLL_INTERVAL=2
CONNECT_TIMEOUT=5
QUERY_TIMEOUT=1.5
AUTO_RECONNECT=true
AUTO_CONNECT=true
# Log mode: sekunder mellem fulde polls (2-3600).
LOG_POLL_INTERVAL=5
# Systemets ejer - står i rapporter og logfiler.
OWNER=Jan Green Larsen
APP_PORT=8070
LOG_LEVEL=INFO
